{
  "name": "dsh-worklog",
  "version": "0.1.0",
  "description": "DSH 工作日志日历：全量汇总所有会话，按天登记工作时长与内容摘要，支持生成日报/周报/半年总结（Host 核心）。",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/endpoints.test.mjs tests/transcript.test.mjs tests/client-smoke.test.mjs",
    "build:client": "node scripts/build-gui-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.gui.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }
  },
  "keywords": ["dsh-plugin", "dsh", "worklog", "calendar", "report", "deepseek-harness"],
  "license": "MIT"
}
